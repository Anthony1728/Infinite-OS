{
  "name": "infinite-ai",
  "version": "0.1.1",
  "private": true,
  "main": "out/main/index.js",
  "description": "A local-first AI operating workspace for chat, code, browser and PC automation, builders, and everyday work.",
  "author": "Anthony Matthews",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anthony5109/Infinite-OS.git"
  },
  "homepage": "https://github.com/Anthony5109/Infinite-OS#readme",
  "bugs": {
    "url": "https://github.com/Anthony5109/Infinite-OS/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "exec": "node scripts/exec.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:list": "node scripts/eval.mjs --list",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.infiniteai.os",
    "productName": "Infinite OS",
    "copyright": "Copyright © 2026 Anthony Matthews",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "pc-live-map",
        "to": "pc-live-map"
      },
      {
        "from": "extensions/infinite-os-bridge",
        "to": "infinite-os-bridge"
      }
    ],
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-win32-x64/**",
      "resources/scripts/**"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@codebuff/sdk": "^0.10.7",
    "@fastify/cors": "^11.2.0",
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/ripgrep": "^1.15.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chokidar": "^3.6.0",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "dompurify": "3.4.11",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0",
    "exceljs": "^4.4.0",
    "fast-glob": "^3.3.2",
    "fastify": "^5.8.5",
    "form-data": "4.0.6",
    "framer-motion": "^12.40.0",
    "hono": "4.12.25",
    "imapflow": "^1.4.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.17.0",
    "mermaid": "^12.3.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "openai": "^4.67.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "pino-pretty": "^11.2.2",
    "playwright-core": "1.60.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.22.0",
    "tinyglobby": "^0.2.0",
    "uuid": "11.1.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-win32-x64": "1.18.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@playwright/test": "^1.47.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "39.8.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}