# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
release/
out/
.vite/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local

# Editors
.idea/
.vscode/
!src/renderer/.vscode/

# Local safety snapshots (scripts/backup.mjs)
.backups/

# Per-session self-edit snapshots (agent Snapshot tool)
.infinite-backups/

# Local agent/session state
.infinite/
.freebuff/

# Scratch and unpacked tool output
/src-backup-*.zip
/c
nul

# Bridge extension config: regenerated at runtime with a live auth token.
# Never commit it.
extensions/*/config.js
!extensions/*/config.example.js

# Python bytecode (local scripts)
__pycache__/
*.pyc
